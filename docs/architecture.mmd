graph TD
  subgraph UI["UI (Reportante, Tecnico, Coordinador)"]
    ScreenList["IncidentListScreen"]
    ScreenDetail["IncidentDetailScreen"]
  end

  subgraph Application["Application"]
    UC1["ListIncidents (caso de uso)"]
    UC2["GetIncidentDetail (caso de uso)"]
  end

  subgraph Domain["Domain"]
    Model["Incident (modelo)"]
    Contract["IncidentRepository (contrato)"]
    SessionPort["SessionGateway (previsto, futuras semanas)"]
    LocationPort["LocationProvider (previsto, futuras semanas)"]
  end

  subgraph Infrastructure["Infrastructure"]
    Fake["FakeIncidentRepository (memoria)"]
    HealthAdapter["CourseBackendHealthGateway"]
    PersistPort["Almacenamiento local (previsto)"]
    LocationAdapter["Geocodificacion (previsto)"]
  end

  subgraph Bootstrap["Composition root (bootstrap)"]
    Compose["campusOpsServices"]
  end

  ScreenList --> UC1
  ScreenDetail --> UC2
  UC1 --> Contract
  UC2 --> Contract
  Fake -.implementa.-> Contract
  Compose --> Fake
  Compose --> HealthAdapter
  Compose --> UC1
  Compose --> UC2
  Compose --> ScreenList
  Compose --> ScreenDetail
  PersistPort -.implementa.-> SessionPort
  LocationAdapter -.implementa.-> LocationPort
